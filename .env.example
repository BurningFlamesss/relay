# ===========================================
# REQUIRED - Must be set for the app to work
# ===========================================

# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ===========================================
# DATABASE & CACHE (Use local Docker or external)
# ===========================================

# For local Docker (run: npm run docker:dev)
DATABASE_URL=postgresql://relay:relay_dev_password@localhost:5432/relay?schema=public
REDIS_CONNECTION_STRING=redis://localhost:6379
REDIS_CACHE_CONNECTION_STRING=redis://localhost:6379

# For external services (Prisma Postgres, Upstash Redis, etc.)
# DATABASE_URL=postgresql://user:pass@host:5432/db?schema=public
# REDIS_CONNECTION_STRING=rediss://user:pass@host:6379
# REDIS_CACHE_CONNECTION_STRING=rediss://user:pass@host:6379

# ===========================================
# APPLICATION URLs
# ===========================================

BETTER_AUTH_URL=http://localhost:3000
VITE_APP_URL=http://localhost:3000

NODE_ENV=development

# ===========================================
# OPTIONAL - Analytics & Monitoring
# ===========================================

# PostHog Analytics (optional) - Get from: https://app.posthog.com/project/settings
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ===========================================
# OPTIONAL - AI Providers
# ===========================================

# OpenRouter (already set above)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Crawl4AI (optional - for web scraping) - Run locally via Docker or use external
CRAWL4AI_URL=http://localhost:11235
CRAWL4AI_API_TOKEN=

# ===========================================
# OPTIONAL - Research Pipeline Tuning
# ===========================================

RESEARCH_MAX_ITERATIONS=3
RESEARCH_MAX_SOURCES=30
RESEARCH_MAX_PAGES=100
RESEARCH_CRAWL_TIMEOUT_MS=60000
RESEARCH_AI_TIMEOUT_MS=120000

# ===========================================
# OPTIONAL - Worker Configuration
# ===========================================

WORKER_TYPE=orchestrator
WORKER_HEALTH_PORT=3001

# ===========================================
# OPTIONAL - Email (for auth)
# ===========================================

USER=
APP_PASSWORD=

# ===========================================
# OPTIONAL - Speech (ElevenLabs)
# ===========================================

ELEVENLABS_API_KEY=