# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

DATABASE_URL=postgresql://relay:relay_dev_password@postgres:5432/relay?schema=public
REDIS_CONNECTION_STRING=redis://redis:6379
REDIS_CACHE_CONNECTION_STRING=redis://redis:6379
CRAWL4AI_URL=http://crawl4ai:11235
BETTER_AUTH_URL=http://localhost:3000
VITE_APP_URL=http://localhost:3000

NODE_ENV=development

# PostHog Analytics (optional)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Crawl4AI
CRAWL4AI_API_TOKEN=

# Research Pipeline Settings
RESEARCH_MAX_ITERATIONS=3
RESEARCH_MAX_SOURCES=30
RESEARCH_MAX_PAGES=100
RESEARCH_CRAWL_TIMEOUT_MS=60000
RESEARCH_AI_TIMEOUT_MS=120000

# Worker
WORKER_TYPE=orchestrator
WORKER_HEALTH_PORT=3001

# Email
USER=xyz@gmail.com
APP_PASSWORD=YOUR_PASS

# Speech
ELEVENLABS_API_KEY=