generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AnalysisTier {
  LOW
  MID
  HIGH
}

enum JobStatus {
  QUEUED
  RUNNING
  ITERATING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum PhaseStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum PhaseType {
  PREFLIGHT
  QUERY_ARCHITECTURE
  SIGNAL_SCRAPING
  SIGNAL_PREPROCESSING
  PROBLEM_CLUSTER_SYNTHESIS
  ITERATION_GATE
  OPPORTUNITY_QUALIFICATION
  COMPETITIVE_DEEP_DIVE
  MARKET_SIZING
  SCORING
  SYNTHESIS
  REPORT_ASSEMBLY
  DELIVERY
}

enum ScrapingSourceType {
  REDDIT
  HACKER_NEWS
  CAPTERRA
  TRUSTPILOT
  GITHUB
  GITHUB_ISSUES
  STACK_OVERFLOW
  DEV_TO
  LINKEDIN_JOBS
  PRODUCT_HUNT
  APP_STORE
}

enum SignalIntentLabel {
  COMPLAINT
  WORKAROUND
  DEMAND
  COMPETITOR
  FAILURE_POST
  FEATURE_REQUEST
}

enum AuthorType {
  DEVELOPER
  BUSINESS_OWNER
  CONSUMER
  STUDENT
  UNKNOWN
}

enum IdeaStatus {
  PENDING
  APPROVED
  HELD
  DISCARDED
}

enum CandidateStatus {
  ACTIVE
  STASHED
  PROMOTED
  ELIMINATED
}

enum CouponType {
  FIXED_CREDITS
  PERCENT_DISCOUNT
  FIXED_DISCOUNT
}

enum CouponRedemptionType {
  DIRECT_REDEEM
  CHECKOUT
}

enum CouponStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
  DISABLED
}

enum PaymentStatus {
  CREATED
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum CreditTransactionType {
  PURCHASE
  COUPON
  JOB_RESERVE
  JOB_SPEND
  JOB_RELEASE
  JOB_REFUND
  ADMIN_GRANT
  PAYMENT_REFUND
  ADJUSTMENT
}

enum Currency {
  USD
  NPR
  EUR
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  ESEWA
  MANUAL
}

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]

  creditWallet       CreditWallet?
  jobs               AnalysisJob[]
  ideas              Idea[]
  couponUses         CouponUsage[]
  payments           Payment[]
  creditTransactions CreditTransaction[]
  notifications      Notification[]

  ideaCandidates    IdeaCandidate[] @relation("CandidateOwner")
  stashedCandidates IdeaCandidate[] @relation("StashedByUser")

  @@unique([email])
  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model CreditWallet {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance        Int      @default(0)
  reserved       Int      @default(0)
  lifetimeEarned Int      @default(0)
  lifetimeSpent  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("credit_wallets")
}

model CreditTransaction {
  id            String                @id @default(cuid())
  userId        String
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          CreditTransactionType
  amount        Int
  balanceAfter  Int
  reservedAfter Int
  description   String?
  referenceId   String?
  source        String?
  createdAt     DateTime              @default(now())

  @@index([userId])
  @@index([referenceId])
  @@map("credit_transactions")
}

model CreditPack {
  id           String   @id @default(cuid())
  name         String
  creditAmount Int
  price        Int
  currency     Currency
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payments Payment[]

  @@index([isActive, sortOrder])
  @@map("credit_packs")
}

model Payment {
  id                    String          @id @default(cuid())
  userId                String
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider              PaymentProvider
  status                PaymentStatus   @default(PENDING)
  providerTransactionId String?
  orderId               Int             @unique
  creditPackId          String
  creditPack            CreditPack      @relation(fields: [creditPackId], references: [id])
  currency              Currency
  subTotal              Int
  discount              Int             @default(0)
  total                 Int
  creditsGranted        Int
  couponUsageId         String?         @unique
  couponUsage           CouponUsage?    @relation(fields: [couponUsageId], references: [id])
  metadata              Json?
  paidAt                DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([userId])
  @@map("payments")
}

model Coupon {
  id                       String               @id @default(cuid())
  code                     String               @unique
  type                     CouponType
  redemptionType           CouponRedemptionType
  status                   CouponStatus         @default(ACTIVE)
  creditAmount             Int?
  percentDiscount          Int?
  fixedDiscount            Int?
  maxUses                  Int?
  usedCount                Int                  @default(0)
  perUserLimit             Int                  @default(1)
  minimumPurchaseAmount    Int?
  startsAt                 DateTime?
  expiresAt                DateTime?
  applicationCreditPackIds String[]
  metadata                 String?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  uses CouponUsage[]

  @@map("coupons")
}

model CouponUsage {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponId        String
  coupon          Coupon   @relation(fields: [couponId], references: [id])
  payment         Payment?
  discountApplied Int?
  creditsGranted  Int?
  createdAt       DateTime @default(now())

  @@index([couponId, userId])
  @@map("coupon_usages")
}

model TopicCache {
  id                  String   @id @default(cuid())
  topicHash           String   @unique
  topicNormalised     String
  lastAnalysedAt      DateTime
  cacheExpiresAt      DateTime
  representativeJobId String
  hitCount            Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([topicHash])
  @@index([cacheExpiresAt])
  @@map("topic_cache")
}

model AnalysisJob {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  topic     String
  topicHash String
  filters   Json?

  tier          AnalysisTier
  maxIterations Int          @default(1)

  fromCandidateId String?
  fromCandidate   IdeaCandidate? @relation("CandidatePromotion", fields: [fromCandidateId], references: [id])

  servedFromCacheId String?

  creditsReserved  Int
  creditsFinalCost Int @default(0)
  creditsRefunded  Int @default(0)

  status       JobStatus @default(QUEUED)
  currentPhase PhaseType @default(PREFLIGHT)

  iterationsDone Int     @default(0)
  bullJobId      String? @unique

  phases     JobPhase[]
  scrapeJobs ScrapeJob[]
  signals    Signal[]
  candidates IdeaCandidate[] @relation("JobCandidates")

  idea Idea?

  isRerun     Boolean       @default(false)
  parentJobId String?
  parentJob   AnalysisJob?  @relation("JobRerun", fields: [parentJobId], references: [id])
  reruns      AnalysisJob[] @relation("JobRerun")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([userId])
  @@index([status])
  @@index([topicHash])
  @@index([fromCandidateId])
  @@map("analysis_job")
}

model JobPhase {
  id     String      @id @default(cuid())
  jobId  String
  job    AnalysisJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  phase  PhaseType
  status PhaseStatus @default(PENDING)

  input        Json?
  output       Json?
  summary      Json?
  errorMessage String?
  errorStack   String?
  retryCount   Int     @default(0)

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([jobId, phase])
  @@index([jobId])
  @@map("job_phase")
}

model ScrapeJob {
  id           String             @id @default(cuid())
  jobId        String
  job          AnalysisJob        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  source       ScrapingSourceType
  queries      String[]
  status       PhaseStatus        @default(PENDING)
  signalCount  Int                @default(0)
  bullJobId    String?            @unique
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime           @default(now())

  @@index([jobId])
  @@index([status])
  @@map("scrape_job")
}

model Signal {
  id    String @id @default(cuid())
  JobId String

  Job AnalysisJob @relation(fields: [JobId], references: [id], onDelete: Cascade)

  source       ScrapingSourceType
  url          String
  urlHash      String
  title        String?
  quote        String
  authorHandle String?
  authorType   AuthorType         @default(UNKNOWN)
  publishedAt  DateTime?

  intentLabel    SignalIntentLabel?
  intensityScore Float?
  isDemandSignal Boolean            @default(false)

  clusterId String?
  cluster   SignalCluster? @relation(fields: [clusterId], references: [id])

  createdAt DateTime @default(now())

  @@index([JobId])
  @@index([clusterId])
  @@index([urlHash])
  @@index([isDemandSignal])
  @@map("signal")
}

model SignalCluster {
  id                String @id @default(cuid())
  jobId             String
  label             String
  frequency         Int
  intensityScore    Float
  demandSignalCount Int    @default(0)
  personaSketches   Json
  failedWorkarounds Json
  evidenceChain     Json
  compositeScore    Float  @default(0)

  signals    Signal[]
  candidates IdeaCandidate[] @relation("ClusterCandidate")
  createdAt  DateTime        @default(now())

  @@index([jobId])
  @@map("signal_cluster")
}

model IdeaCandidate {
  id String @id @default(cuid())

  jobId String
  job   AnalysisJob @relation("JobCandidates", fields: [jobId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation("CandidateOwner", fields: [userId], references: [id])

  stashedByUserId String?
  stashedByUser   User?     @relation("StashedByUser", fields: [stashedByUserId], references: [id])
  stashedAt       DateTime?

  promotedJobs AnalysisJob[] @relation("CandidatePromotion")

  clusterId String?
  cluster   SignalCluster? @relation("ClusterCandidate", fields: [clusterId], references: [id])

  problemLabel   String
  problemSummary String
  targetPersona  String?

  competitorMap   Json?
  featureGaps     Json?
  deadCompetitors Json?

  communitySize    Json?
  jobPostingVolume Int?
  fundingSignals   Json?
  trendDirection   String?
  whyNow           String?

  problemScore     Float?
  competitionScore Float?
  marketScore      Float?
  timingScore      Float?
  compositeScore   Float?
  scoringBreakdown Json?

  status CandidateStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([jobId])
  @@index([userId])
  @@index([status])
  @@index([compositeScore])
  @@index([clusterId])
  @@map("idea_candidate")
}

model Idea {
  id    String      @id @default(cuid())
  jobId String      @unique
  job   AnalysisJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  problemStatement     String
  targetPersona        String
  solutionHypothesis   String
  mvpScope             String
  differentiationAngle String
  goToMarketChannel    String

  riskFactors         Json
  confidenceLevels    Json
  compositeScore      Float
  scoringBreakdown    Json
  signalTimelineChart Json?
  competitorLandscape Json?
  browsableSignals    Json?

  status       IdeaStatus @default(PENDING)
  userFeedback String?
  actionAt     DateTime?

  approvedDomain String?
  approvedAt     DateTime?

  isResuable      Boolean   @default(false)
  reusableContext Json?
  reusableAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([approvedDomain])
  @@index([isResuable])
  @@map("idea")
}

model ApprovedDomainExclusion {
  id           String   @id @default(cuid())
  userId       String
  ideaId       String   @unique
  domainLabel  String
  domainHash   String   @unique
  excludeSince DateTime @default(now())

  @@index([userId])
  @@index([domainHash])
  @@map("approved_domain_exclusion")
}

model ReusableIdeaContext {
  id            String   @id @default(cuid())
  ideaId        String   @unique
  userId        String
  topicTags     String[]
  topicHash     String
  problemLabel  String
  whyDiscarded  String?
  userFeedback  String?
  qualitySignal Int      @default(0)

  createdAt DateTime @default(now())

  @@index([topicHash])
  @@index([topicTags])
  @@map("reusable_idea_context")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@map("notification")
}
